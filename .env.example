# Copy to .env for local development. Never commit real credentials.
NODE_ENV=development
API_PORT=3000
WEB_ORIGIN=http://localhost:4200
API_ORIGIN=http://localhost:3000

# Local PostgreSQL / pgvector
POSTGRES_DB=ledgerloop
POSTGRES_USER=ledgerloop
POSTGRES_PASSWORD=local_dev_only_change_me
DATABASE_URL=postgresql://ledgerloop:local_dev_only_change_me@localhost:5432/ledgerloop

# Local Redis / BullMQ
REDIS_URL=redis://localhost:6379
WORKER_CONCURRENCY=1

# Local S3-compatible storage (MinIO)
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET=ledgerloop-local
S3_ACCESS_KEY_ID=ledgerloop_local
S3_SECRET_ACCESS_KEY=local_dev_only_change_me
S3_FORCE_PATH_STYLE=true
MINIO_ROOT_USER=ledgerloop_local
MINIO_ROOT_PASSWORD=local_dev_only_change_me

# Authentication; replace with unique high-entropy values outside this template.
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_TOKEN_SECRET=replace_with_a_random_secret_of_at_least_32_bytes
CSRF_SECRET=replace_with_a_different_random_secret_of_at_least_32_bytes
COOKIE_SECURE=false
COOKIE_DOMAIN=localhost

# Optional Google sign-in; leave empty until configured.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Optional AI integration; never expose this key to the browser.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
AI_MONTHLY_QUOTA_PER_COMPANY=1000

# Upload policy (limits are bytes)
UPLOAD_MAX_FILE_BYTES=10485760
UPLOAD_ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png
UPLOAD_SCANNER_URL=

# Reminder delivery; configure only when a provider is implemented.
REMINDER_FROM_EMAIL=
EMAIL_PROVIDER_API_KEY=
